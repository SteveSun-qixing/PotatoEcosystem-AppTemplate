{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist-electron"
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts"
  ]
}
