{
  "name": "@chips/app-template",
  "version": "1.0.0",
  "description": "薯片生态标准模板应用 - Chips Ecosystem Standard App Template",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,yaml,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,yaml,json,html}\"",
    "clean": "rm -rf dist dist-electron node_modules/.vite"
  },
  "dependencies": {
    "@chips/components": "file:../Chips-ComponentLibrary/packages/component-library",
    "@chips/sdk": "file:../Chips-SDK",
    "js-yaml": "^4.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^1.3.0",
    "electron": "^40.2.1",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "happy-dom": "^13.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.3.0",
    "vue-tsc": "^1.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveSun-qixing/PotatoEcosystem-AppTemplate"
  },
  "keywords": [
    "chips",
    "template",
    "app-template",
    "react",
    "typescript",
    "electron"
  ],
  "author": "Chips Ecosystem",
  "license": "MIT"
}
