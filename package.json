{
  "name": "@chips/app-template",
  "version": "1.0.0",
  "description": "薯片生态标准模板应用 - Chips Ecosystem Standard App Template",
  "type": "module",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts,.vue",
    "lint:fix": "eslint src --ext .ts,.vue --fix",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,vue,yaml,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,yaml,json}\"",
    "clean": "rm -rf dist dist-electron node_modules/.vite"
  },
  "dependencies": {
    "@chips/sdk": "workspace:*",
    "@chips/components": "workspace:*",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "js-yaml": "^4.1.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@typescript-eslint/eslint-plugin": "^6.18.0",
    "@typescript-eslint/parser": "^6.18.0",
    "@vitejs/plugin-vue": "^4.5.0",
    "@vitest/coverage-v8": "^1.3.0",
    "@vue/test-utils": "^2.4.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-vite": "^2.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.19.0",
    "happy-dom": "^13.0.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vitest": "^1.3.0",
    "vue-tsc": "^1.8.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SteveSun-qixing/PotatoEcosystem-AppTemplate"
  },
  "keywords": [
    "chips",
    "template",
    "app-template",
    "vue3",
    "typescript",
    "electron"
  ],
  "author": "Chips Ecosystem",
  "license": "MIT"
}
